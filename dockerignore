# =============================================================================
#  .dockerignore - must live in the Docker build context root (next to the
#  Dockerfile, or at the "Base Directory" configured in Coolify/Dokploy).
#
#  Without this file `COPY . .` bakes your .env, vendor/, node_modules/ and
#  host build caches into the image: leaked secrets, a bloated build context,
#  and a host-built vendor/ that overwrites the one Composer just installed.
# =============================================================================

# --- version control and editor/OS noise ---
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml
.idea
.vscode
.editorconfig
.DS_Store
*.swp
*.swo
*~

# --- secrets and local environment (never bake these) ---
.env
.env.*
auth.json

# --- local Docker/compose files (the image does not need them) ---
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml
docker-compose*.yaml
compose*.yml
compose*.yaml

# --- dependencies: rebuilt inside the image for the right platform ---
/vendor
/node_modules
/.pnpm-store
/.yarn

# --- frontend build output: regenerated by the assets stage ---
# If you commit prebuilt assets and have no package.json/build step, delete
# the /public/build line below or the image will ship without your assets.
/public/build
/public/hot
/public/storage

# --- runtime state: belongs on a volume, not in the image ---
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/public/*
/bootstrap/cache/*.php

# --- local databases, logs and test tooling ---
/database/*.sqlite
/database/*.sqlite-journal
*.log
/tests
/phpunit.xml
/phpunit.xml.dist
/.phpunit.cache
/.php-cs-fixer.cache
/.php-cs-fixer.php
/.phpstan.cache
/coverage

# --- documentation ---
README.md
CHANGELOG.md
LICENSE.md

# NOTE: never ignore composer.json, composer.lock, package.json or the
# lockfiles - the build needs them to install reproducible dependencies.
